{
  "id": "wto",
  "abbr": "WTO",
  "name": {
    "en": "World Trade Organization",
    "zh": "世界貿易組織"
  },
  "category": "economic",
  "founded": "1995",
  "headquarters": {
    "en": "Geneva, Switzerland",
    "zh": "瑞士日內瓦"
  },
  "nature": {
    "en": "Intergovernmental organization of states and separate customs territories that sets and enforces global trade rules",
    "zh": "由國家與獨立關稅領域組成、制定並執行全球貿易規則的政府間國際組織"
  },
  "purpose": {
    "en": "The WTO sets the rules for trade between its members, provides a forum to negotiate lower trade barriers, and settles trade disputes. It succeeded the GATT (1947) in 1995.",
    "zh": "WTO制定成員間的國際貿易規則，提供談判降低貿易障礙的平台，並處理貿易爭端；1995年取代關稅暨貿易總協定（GATT）。"
  },
