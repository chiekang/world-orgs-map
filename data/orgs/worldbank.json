 "name": {
  "en": "World Bank (IBRD/IDA)",
  "zh": "世界銀行"
 },
 "category": "financial",
 "founded": "1944",
 "headquarters": {
  "en": "Washington, D.C., United States",
  "zh": "美國華盛頓特區"
 },
 "nature": {
  "en": "Specialized agency of the UN system; multilateral development bank owned by its member countries",
  "zh": "聯合國體系專門機構；由會員國共同持有的多邊開發銀行"
 },
 "purpose": {
  "en": "The World Bank lends to and advises developing countries to reduce poverty and boost shared prosperity, funding projects such as roads, power, schools and health. The IBRD and IDA together form the World Bank; the wider World Bank Group also includes IFC, MIGA and ICSID. Created at Bretton Woods in 1944.",
  "zh": "世界銀行向開發中國家提供貸款與政策建議，以消除貧窮、促進共享繁榮，資助道路、電力、學校與醫療等計畫。IBRD與IDA合稱世界銀行，世界銀行集團另含IFC、MIGA與ICSID。1944年布列敦森林會議創立。"
 },
