{
 "id": "interpol",
 "abbr": "INTERPOL",
 "name": {
  "en": "International Criminal Police Organization",
  "zh": "國際刑警組織"
 },
 "category": "political_security",
 "founded": "1923",
 "headquarters": {
  "en": "Lyon, France",
  "zh": "法國里昂"
 },
 "nature": {
  "en": "Intergovernmental police-cooperation organization (not a UN body)",
  "zh": "政府間警察合作組織（非聯合國機構）"
 },
 "purpose": {
  "en": "INTERPOL connects the police of its member countries so they can share information and run joint operations against cross-border crime such as fraud, cybercrime and trafficking. It issues colour-coded Notices (e.g. Red Notice) to alert police worldwide. Founded in Vienna in 1923; it does not arrest anyone itself.",
  "zh": "國際刑警組織串連會員國警方，分享情資並共同執行行動，對抗詐欺、網路犯罪、人口販運等跨國犯罪；並發布彩色通報（如紅色通報）通知各國警方。1923年於維也納創立，本身不直接逮捕人。"
 },
