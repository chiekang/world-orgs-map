{
 "id": "ipcc",
 "abbr": "IPCC",
 "name": {
  "en": "Intergovernmental Panel on Climate Change",
  "zh": "政府間氣候變遷專門委員會"
 },
 "category": "other",
 "founded": "1988",
 "headquarters": {
  "en": "Secretariat in Geneva, Switzerland",
  "zh": "秘書處設於瑞士日內瓦"
 },
 "nature": {
  "en": "Scientific body of the UN, hosted by WMO and UNEP; governments approve its reports",
  "zh": "聯合國的科學評估機構，由WMO與UNEP設立；報告由各國政府共同審議通過"
 },
 "purpose": {
  "en": "The IPCC does not do its own research. It assesses the published science on climate change, its impacts and responses, and writes Assessment Reports that governments approve line by line. These reports underpin the UNFCCC, the Paris Agreement and COP negotiations. Created in 1988 by WMO and UNEP.",
  "zh": "IPCC不自己做研究，而是評估已發表的氣候變遷科學、衝擊與因應方案，撰寫《評估報告》並由各國政府逐行審議通過。這些報告是《聯合國氣候變遷綱要公約》、《巴黎協定》與COP談判的科學基礎。1988年由WMO與UNEP設立。"
 },
