{
  "id": "oecd",
  "abbr": "OECD",
  "name": {
    "en": "Organisation for Economic Co-operation and Development",
    "zh": "經濟合作暨發展組織"
  },
  "category": "economic",
  "founded": "1961",
  "headquarters": {
    "en": "Paris, France",
    "zh": "法國巴黎"
  },
  "nature": {
    "en": "Intergovernmental organisation (treaty-based) of mostly high-income market economies",
    "zh": "以條約為基礎的政府間國際組織，成員多為高所得市場經濟體"
  },
  "purpose": {
    "en": "Member governments compare data and policies and set common standards (e.g. tax, anti-bribery, education via PISA) to promote economic growth and better public policy. Often called the 'rich countries' club'.",
    "zh": "成員國政府透過比較數據與政策、制定共同標準（如稅務、反賄賂、PISA教育評量），促進經濟成長與良好公共政策，常被稱為「富國俱樂部」。"
  },
